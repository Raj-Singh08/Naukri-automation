# Copy this file to `.env` and fill in your Naukri credentials.
#
#   cp .env.example .env
#
# `.env` is ignored by git (see .gitignore) — your password is never
# committed. For GitHub Actions, set the same two values as Secrets
# instead (README → GitHub Secrets).

NAUKRI_EMAIL=you@example.com
NAUKRI_PASSWORD=YourNaukriPassword

# --- Optional browser behaviour ---------------------------------------
# Run with a visible browser window (for solving CAPTCHAs by hand) and
# use your installed browser instead of Playwright's bundled headless
# Chromium (which Naukri's bot protection easily detects). Both default
# to the values shown; for CI runs these are ignored (headless + bundled).
# NAUKRI_HEADLESS=false
# NAUKRI_CHANNEL=msedge
